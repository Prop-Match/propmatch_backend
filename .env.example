# Copy this file to .env and supply local, non-committed values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?schema=public

JWT_ACCESS_SECRET=strong-access-secret
JWT_REFRESH_SECRET=strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Separate HMAC key for pseudonymous property-view visitor hashes.
ANALYTICS_HASH_SECRET=strong-analytics-hash-secret

PORT=3001
BACKEND_PUBLIC_URL="http://localhost:3001"

# SBG remains dedicated to property-description chat generation.
SBG_API_KEY=
SBG_CHAT_MODEL=openai.gpt-oss-120b-1:0
SBG_BASE_URL=
SBG_EMBEDDING_ENDPOINT=/api/v1/student/embed
SBG_EMBEDDING_MODEL=us.cohere.embed-v4:0

# Read by PropertyEmbeddingService — the actual primary embedding provider
# for property/tenant-request matching (semantic search + the hybrid
# matchmaker). Without COHERE_API_KEY, every embedding call throws
# COHERE_EMBEDDING_NOT_CONFIGURED and falls straight to the local fallback
# below (or fails outright if that's also unavailable).
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0
# Must be one of 256, 512, 1024, 1536 — anything else is silently ignored
# and 1024 is used instead.
COHERE_EMBEDDING_DIMENSION=1024

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=propmatch_documents_local_v1
LOCAL_EMBEDDINGS_URL=http://127.0.0.1:8001
# Minimum cosine similarity for semantic property-search candidates (-1 to 1).
# The default is 0.65 when this variable is not set.
SEMANTIC_MIN_SIMILARITY=0.65

# payments
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
# Read by paymob.service.ts; get these from the Paymob dashboard.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_WALLET_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# matching queue (BullMQ)
REDIS_URL=redis://localhost:6380
# Job retry/retention tuning — see MatchingQueueConfig. All optional, each
# falls back to the default noted below if unset.
MATCHING_JOB_ATTEMPTS=3
MATCHING_JOB_BACKOFF_MS=5000
MATCHING_REMOVE_ON_COMPLETE_AGE_SECONDS=86400
MATCHING_REMOVE_ON_COMPLETE_COUNT=1000
MATCHING_REMOVE_ON_FAIL_AGE_SECONDS=604800
# Read directly from process.env at module-load time, before Nest's DI is
# available — see the comment above MATCHING_WORKER_CONCURRENCY in
# matching.worker.ts for why this one can't go through ConfigService.
MATCHING_WORKER_CONCURRENCY=5

# legal support
LEGAL_SUPPORT_API_URL=http://localhost:8001
LEGAL_SUPPORT_INTERNAL_API_KEY=strong-legal-support-api-key
LEGAL_SUPPORT_TIMEOUT_MS=120000

# frontend and email settings
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="منصة PropMatch <noreply@propmatch.com>"
MAIL_JOB_ATTEMPTS=5
MAIL_JOB_BACKOFF_MS=5000
