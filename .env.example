# Copy this file to .env and supply local, non-committed values.
POSTGRES_USER=propmatch
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_DB=propmatch

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?schema=public

JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
BACKEND_PUBLIC_URL="http://localhost:3001"
PRIVATE_STORAGE_ROOT=./.private-storage

# SBG remains dedicated to property-description chat generation.
SBG_API_KEY=
SBG_CHAT_MODEL=openai.gpt-oss-120b-1:0
SBG_BASE_URL=
SBG_EMBEDDING_ENDPOINT=/api/v1/student/embed
SBG_EMBEDDING_MODEL=us.cohere.embed-v4:0
# Cohere is the primary provider. The local sidecar remains the automatic
# fallback for transient Cohere failures (timeouts, rate limits, and 5xx).
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_EMBEDDING_DIMENSION=1024
# Set false to run Cohere only. Set true to enable local fallback and dual indexing.
LOCAL_EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./chroma_data
CHROMA_COHERE_COLLECTION=propmatch_properties_cohere_v1
CHROMA_LOCAL_COLLECTION=propmatch_properties_local_v1
LOCAL_EMBEDDINGS_URL=http://127.0.0.1:8001
# Minimum cosine similarity for semantic property-search candidates (-1 to 1).
# The default is 0.65 when this variable is not set.
SEMANTIC_MIN_SIMILARITY=0.65


PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
# Read by paymob.service.ts; get these from the Paymob dashboard.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
