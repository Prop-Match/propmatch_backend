// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

// Admin sub-role (only meaningful when role == ADMIN). NULL is treated as
// SUPER_ADMIN for backward-compatibility with admins created before this column.
enum AdminRole {
  SUPER_ADMIN
  LISTINGS_MANAGER
  KYC_REVIEWER
  FINANCE_ADMIN
  REVIEWS_MANAGER
  CUSTOMER_SUPPORT
  READ_ONLY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum PropertyType {
  APARTMENT
  VILLA
  STUDIO
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ConnectionStatus {
  INTERESTED
  CONNECTED
  REJECTED
}

enum PaymentType {
  OWNER_PLUS_MONTHLY
  OWNER_PLUS_YEARLY
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
  EXTRA_LISTING_60D
  OFFERS_10_60D
  BOOST_7D
  BOOST_14D
  BOOST_30D
  AI_USES_10_90D
  PREMIUM_OWNER
  OWNER_PLUS
  SINGLE_LISTING
  SINGLE_OFFER
  BOOST_LISTING
  AI_ADDON
  DOCS_PACK
  LEGACY_OWNER_PLUS
  LEGACY_NEW_LISTING
  LEGACY_BOOST_LISTING
  LEGACY_REFILL_MATCHES
  LEGACY_OFFER_PACK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYMOB
}

enum OwnerPlan {
  FREE
  OWNER_PLUS
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum EntitlementType {
  ACTIVE_LISTING
  MATCHED_OFFER
  AI_OPTIMIZER_USE
}

enum EntitlementSource {
  PLAN
  ADDON
  MIGRATION
}

enum AnalyticsTrafficSource {
  ORGANIC
  BOOSTED
}

enum BoostCampaignStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NotificationType {
  EKYC_APPROVED
  EKYC_RESUBMISSION_REQUIRED
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  NEW_MATCH
  PAYMENT_SUCCESS
  NEW_REVIEW_SUBMITTED
  REVIEW_APPROVED
  REVIEW_REJECTED
  NEW_TENANT_REQUEST
  TENANT_REQUEST_APPROVED
  TENANT_REQUEST_REJECTED
  NEW_OFFER_RECEIVED
  NEW_MESSAGE
  CONTRACT_READY_FOR_REVIEW
  CONTRACT_APPROVED
  CONTRACT_REJECTED
  USER_REVIEW_RECEIVED
  /**
   * Smart Matchmaker — a landlord's property scored >75 against a new tenant request.
   */
  HIGH_MATCH_TENANT_REQUEST
  ACCOUNT_REACTIVATED
  ACCOUNT_REACTIVATION_REJECTED
  /**
   * A soft-deleted user requested reactivation — persisted to admins' bells.
   */
  REACTIVATION_REQUEST
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CLOSED
  /**
   * The tenant's account was soft-deleted — distinct from CLOSED (which the
   * tenant chooses themselves) so an admin audit can tell the two apart.
   */
  ARCHIVED
}

enum OwnerOfferStatus {
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

enum PartnerServiceType {
  MOVING
  INSURANCE
}

enum PartnerLeadStatus {
  PENDING
  SENT
  CONVERTED
}

/**
 * Handshake model for lease contracts: the landlord drafts, the tenant
 * reviews and either approves (which is what actually triggers PDF
 * generation) or rejects back to drafting. Neither party can unilaterally
 * produce a signed-looking PDF the other never saw.
 */
enum LeaseContractStatus {
  DRAFTING
  PENDING_TENANT_APPROVAL
  APPROVED
}

enum TenantContractReviewStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  REVIEW_CONFIRMED
}

enum UserReviewDirection {
  TENANT_TO_LANDLORD
  LANDLORD_TO_TENANT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  email        String     @unique
  phoneNumber  String     @map("phone_number")
  passwordHash String     @map("password_hash")
  role         UserRole   @default(TENANT)
  avatarUrl    String?    @map("avatar_url")
  adminRole    AdminRole? @map("admin_role")
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  /**
   * Soft-delete marker. Non-null means the account is deleted — JwtStrategy
   * rejects any token for a user with this set, revoking sessions immediately
   * despite JWTs being otherwise stateless. Distinct from suspension below:
   * a deleted user is a "ghost" (self-delete or 30-day-expired anonymized
   * account) with its own reactivation flow; a suspended user is still a
   * live account, just temporarily/permanently blocked by an admin.
   */
  deletedAt    DateTime?  @map("deleted_at")
  /**
   * Bumped on reactivation (and available for any future forced-logout use).
   * JwtStrategy rejects a token whose embedded tokenVersion doesn't match
   * this, so tokens minted before a reactivation can't outlive it.
   */
  tokenVersion Int        @default(0) @map("token_version")

  activationRequests ActivationRequest[]

  // Admin suspension. suspendedAt != null ⇒ suspended; suspendedUntil null ⇒
  // permanent, a future date ⇒ temporary (auto-expires when it passes).
  suspendedAt      DateTime? @map("suspended_at")
  suspendedUntil   DateTime? @map("suspended_until")
  suspensionReason String?   @map("suspension_reason")
  suspensionNote   String?   @map("suspension_note") @db.Text
  suspendedById    String?   @map("suspended_by_id") @db.Uuid

  //forget password
  resetToken           String?               @map("reset_token")
  resetTokenExpiry     DateTime?             @map("reset_token_expiry")
  emailVerifiedAt      DateTime?             @map("email_verified_at")
  emailOtpHash         String?               @map("email_otp_hash")
  emailOtpExpiresAt    DateTime?             @map("email_otp_expires_at")
  emailOtpAttempts     Int                   @default(0) @map("email_otp_attempts")
  emailOtpSentAt       DateTime?             @map("email_otp_sent_at")
  // Profiles & Settings
  identityVerification IdentityVerification?
  userQuota            UserQuota?
  tenantRequests       TenantRequest[]       @relation("TenantRequests")
  favorites            Favorite[]

  // Property Ownership & Actions
  properties Property[] @relation("PropertyOwner")

  // Offers & Partner Strategic Lead Routing
  ownerOffers         OwnerOffer[]
  partnerLeads        PartnerLead[]
  tenantListingOffers TenantOffer[] @relation("TenantListingOffers")
  ownerListingOffers  TenantOffer[] @relation("OwnerListingOffers")

  // Reviews
  propertyReviews      PropertyReview[] @relation("ReviewWriter")
  submittedUserReviews UserReview[]     @relation("UserReviewAuthor")
  receivedUserReviews  UserReview[]     @relation("UserReviewSubject")

  // Matchmaker Connections
  ownerMatchConnections  MatchConnection[] @relation("OwnerMatchConnections")
  tenantMatchConnections MatchConnection[] @relation("TenantMatchConnections")

  // Administration Approvals
  approvedVerifications IdentityVerification[] @relation("ApprovedVerifications")
  approvedProperties    Property[]             @relation("ApprovedProperties")
  approvedReviews       PropertyReview[]       @relation("ApprovedReviews")
  approvedRequests      TenantRequest[]        @relation("ApprovedRequests")

  // Transactions & Billing
  paymentTransactions PaymentTransaction[]
  entitlementGrants   EntitlementGrant[]
  boostCampaigns      BoostCampaign[]
  propertyViewEvents  PropertyViewEvent[]
  leaseContracts      LeaseContract[]
  notifications       Notification[]
  sentMessages        Message[]

  // Admin activity (team page)
  loginAttempts   LoginAttempt[]
  auditLogEntries AdminAuditLogEntry[]

  // Customer support
  supportTickets  SupportTicket[]  @relation("UserTickets")
  assignedTickets SupportTicket[]  @relation("AdminAssignedTickets")
  supportMessages SupportMessage[]

  @@map("user")
}

model IdentityVerification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // Transitional private field retained for compatibility.
  // Never expose through ordinary APIs or logs.
  nationalId String? @map("national_id")

  nationalIdFrontUrl String @map("national_id_front_url")
  nationalIdBackUrl  String @map("national_id_back_url")
  selfieUrl          String @map("selfie_url")

  status VerificationStatus @default(PENDING)

  // Admin Approval
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewer        User?     @relation("ApprovedVerifications", fields: [reviewedBy], references: [id])
  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("identity_verification")
}

model UserQuota {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String           @unique @map("user_id") @db.Uuid
  user                     User             @relation(fields: [userId], references: [id])
  planType                 OwnerPlan        @default(FREE) @map("plan_type")
  planExpiresAt            DateTime?        @map("plan_expires_at")
  maxActiveListings        Int              @default(1) @map("max_active_listings")
  // Legacy counters retained for a safe rollout. Listing capacity is derived
  // from active properties; optimizer uses are the paid AI allowance.
  freeListingsLeft         Int              @default(0) @map("free_listings_left")
  optimizerUsesLeft        Int              @default(0) @map("optimizer_uses_left")
  freeOffersLeft           Int              @default(5) @map("free_offers_left")
  documentationPackCredits Int              @default(0) @map("documentation_pack_credits")
  billingInterval          BillingInterval? @map("billing_interval")
  currentPeriodStartsAt    DateTime?        @map("current_period_starts_at")
  currentPeriodEndsAt      DateTime?        @map("current_period_ends_at")
  boostCreditsLeft         Int              @default(0) @map("boost_credits_left")
  listingGraceEndsAt       DateTime?        @map("listing_grace_ends_at")
  pendingPlanType          OwnerPlan?       @map("pending_plan_type")
  pendingBillingInterval   BillingInterval? @map("pending_billing_interval")
  pendingPlanStartsAt      DateTime?        @map("pending_plan_starts_at")
  pendingPlanExpiresAt     DateTime?        @map("pending_plan_expires_at")
  lastResetDate            DateTime         @default(now()) @map("last_reset_date")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  @@map("user_quota")
}

model Property {
  id                     String         @id @default(uuid()) @db.Uuid
  ownerId                String         @map("owner_id") @db.Uuid
  owner                  User           @relation("PropertyOwner", fields: [ownerId], references: [id])
  title                  String
  description            String
  country                Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  governorate            Governorate    @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  city                   City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district               String
  manualAddress          String         @map("manual_address")
  propertyType           PropertyType   @map("property_type")
  propertyAroundServices String?        @map("property_around_services") @db.Text
  rentAmount             Float          @map("rent_amount")
  areaM2                 Float          @map("area_m2")
  bedrooms               Int
  bathrooms              Int
  isFurnished            Boolean        @map("is_furnished")
  hasElevator            Boolean        @map("has_elevator")
  hasParking             Boolean        @map("has_parking")
  contactRevealed        Boolean        @default(false) @map("contact_revealed")
  status                 PropertyStatus @default(PENDING)
  rejectionReason        String?        @map("rejection_reason")
  isBoosted              Boolean        @default(false) @map("is_boosted")
  boostedUntil           DateTime?      @map("boosted_until")

  /**
   * Cached copy of the approval-time embedding vector (see
   * PropertyEmbeddingService), stored alongside the row so the hybrid
   * matcher's background worker can pull it in the same SQL query used for
   * the rule-based pre-filter and compute cosine similarity in Node memory
   * instead of a per-candidate ChromaDB round-trip.
   */
  embedding Float[] @default([])

  // Admin Approval
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedByUser User?     @relation("ApprovedProperties", fields: [approvedBy], references: [id])
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  propertyImages   PropertyImage[]
  propertyReviews  PropertyReview[]
  favorites        Favorite[]
  matchConnections MatchConnection[]
  ownerOffers      OwnerOffer[]
  tenantOffers     TenantOffer[]
  boostCampaigns   BoostCampaign[]
  viewEvents       PropertyViewEvent[]
  analyticsDaily   PropertyAnalyticsDaily[]
  governorateId    Int
  cityId           Int
  countryId        Int

  @@map("property")
}

model PropertyImage {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id])
  imageUrl     String   @map("image_url")
  displayOrder Int      @map("display_order")
  isCover      Boolean  @default(false) @map("is_cover")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("property_image")
}

model PropertyReview {
  id         String             @id @default(uuid()) @db.Uuid
  reviewerId String             @map("reviewer_id") @db.Uuid
  reviewer   User               @relation("ReviewWriter", fields: [reviewerId], references: [id])
  propertyId String             @map("property_id") @db.Uuid
  property   Property           @relation(fields: [propertyId], references: [id])
  rating     Int
  comment    String?            @db.Text
  status     VerificationStatus @default(PENDING)

  // Admin Approval
  reviewedBy String?  @map("reviewed_by") @db.Uuid
  reviewerBy User?    @relation("ApprovedReviews", fields: [reviewedBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("property_review")
}

model TenantRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  tenant                User                @relation("TenantRequests", fields: [tenantId], references: [id])
  minBudget             Float               @map("min_budget")
  maxBudget             Float               @map("max_budget")
  preferredLocations    String              @map("preferred_locations")
  propertyType          PropertyType        @map("property_type")
  requiredBedrooms      Int                 @map("required_bedrooms")
  needsFurnished        Boolean             @map("needs_furnished")
  flexibilityScore      Int                 @map("flexibility_score")
  lifestyleRequirements String              @map("lifestyle_requirements") @db.Text
  status                TenantRequestStatus @default(PENDING)
  approvedBy            String?             @map("approved_by") @db.Uuid
  approvedByUser        User?               @relation("ApprovedRequests", fields: [approvedBy], references: [id])
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  ownerOffers           OwnerOffer[]
  matchConnections      MatchConnection[]

  /**
   * Cached copy of the request's embedding vector, generated once by
   * MatchingWorker and reused by OffersService's synchronous browse/offer
   * endpoints (via cosine similarity against Property.embedding, pure local
   * math) — single source of truth so the UI card's matchScore and the
   * proactive notification's finalScore never diverge.
   */
  embedding Float[] @default([])

  @@map("tenant_request")
}

model OwnerOffer {
  id              String           @id @default(uuid()) @db.Uuid
  ownerId         String           @map("owner_id") @db.Uuid
  owner           User             @relation(fields: [ownerId], references: [id])
  tenantRequestId String           @map("tenant_request_id") @db.Uuid
  tenantRequest   TenantRequest    @relation(fields: [tenantRequestId], references: [id])
  propertyId      String?          @map("property_id") @db.Uuid
  property        Property?        @relation(fields: [propertyId], references: [id])
  pitchMessage    String           @map("pitch_message") @db.Text
  proposedPrice   Float            @map("proposed_price")
  status          OwnerOfferStatus @default(SENT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("owner_offer")
}

// Forward-marketplace: a tenant makes a priced offer directly on a landlord's
// listing (no tenant request required). Supports a single landlord counter.
// On ACCEPTED a MatchConnection (CONNECTED) is created, reusing the existing
// messaging / contact-reveal plumbing.
model TenantOffer {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         User              @relation("TenantListingOffers", fields: [tenantId], references: [id])
  propertyId     String            @map("property_id") @db.Uuid
  property       Property          @relation(fields: [propertyId], references: [id])
  ownerId        String            @map("owner_id") @db.Uuid
  owner          User              @relation("OwnerListingOffers", fields: [ownerId], references: [id])
  message        String            @db.Text
  proposedPrice  Float             @map("proposed_price")
  counterPrice   Float?            @map("counter_price")
  counterMessage String?           @map("counter_message") @db.Text
  status         TenantOfferStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([tenantId])
  @@map("tenant_offer")
}

enum TenantOfferStatus {
  PENDING // tenant submitted, awaiting landlord
  COUNTERED // landlord countered, awaiting tenant
  ACCEPTED // accepted for discussion → MatchConnection created
  DECLINED // landlord declined
  WITHDRAWN // tenant withdrew
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     User     @relation(fields: [tenantId], references: [id])
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tenantId, propertyId])
  @@map("favorite")
}

model MatchConnection {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             User             @relation("TenantMatchConnections", fields: [tenantId], references: [id])
  propertyId         String           @map("property_id") @db.Uuid
  property           Property         @relation(fields: [propertyId], references: [id])
  ownerId            String           @map("owner_id") @db.Uuid
  owner              User             @relation("OwnerMatchConnections", fields: [ownerId], references: [id])
  tenantRequestId    String?          @map("tenant_request_id") @db.Uuid
  tenantRequest      TenantRequest?   @relation(fields: [tenantRequestId], references: [id], onDelete: SetNull)
  matchScore         Float            @map("match_score")
  status             ConnectionStatus @default(INTERESTED)
  agreementReachedAt DateTime?        @map("agreement_reached_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  messages           Message[]
  leaseContracts     LeaseContract[]

  @@index([tenantRequestId])
  @@map("match_connection")
}

enum MessageAttachmentType {
  IMAGE
  VIDEO
  AUDIO
}

model Message {
  id                   String                 @id @default(uuid()) @db.Uuid
  matchConnectionId    String                 @map("match_connection_id") @db.Uuid
  senderId             String                 @map("sender_id") @db.Uuid
  body                 String                 @db.Text
  attachmentUrl        String?                @map("attachment_url")
  attachmentType       MessageAttachmentType? @map("attachment_type")
  attachmentName       String?                @map("attachment_name")
  attachmentDurationMs Int?                   @map("attachment_duration_ms")
  createdAt            DateTime               @default(now()) @map("created_at")
  editedAt             DateTime?              @map("edited_at")

  matchConnection MatchConnection @relation(fields: [matchConnectionId], references: [id], onDelete: Cascade)
  sender          User            @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([matchConnectionId, createdAt])
  @@index([senderId])
  @@map("message")
}

model PaymentTransaction {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  user                  User               @relation(fields: [userId], references: [id])
  provider              PaymentProvider    @default(PAYMOB)
  providerOrderId       String             @unique @map("provider_order_id")
  providerTransactionId String?            @map("provider_transaction_id")
  amount                Float
  currency              String             @default("EGP")
  paymentType           PaymentType        @map("payment_type")
  targetPropertyId      String?            @map("target_property_id") @db.Uuid
  productSku            String?            @map("product_sku")
  billingInterval       BillingInterval?   @map("billing_interval")
  catalogSnapshot       Json?              @map("catalog_snapshot")
  status                PaymentStatus      @default(PENDING)
  paidAt                DateTime?          @map("paid_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  entitlementGrants     EntitlementGrant[]
  boostCampaigns        BoostCampaign[]

  @@map("payment_transaction")
}

/**
 * Mutable commercial values. Product meaning remains defined in code so an
 * admin cannot accidentally turn a Boost purchase into another entitlement.
 */
model ProductConfiguration {
  id           String      @id @default(uuid()) @db.Uuid
  paymentType  PaymentType @unique @map("payment_type")
  priceEgp     Int         @map("price_egp")
  quantity     Int?
  validityDays Int?        @map("validity_days")
  durationDays Int?        @map("duration_days")
  enabled      Boolean     @default(true)
  updatedById  String?     @map("updated_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("product_configuration")
}

/**
 * Monthly plan allowances used for new periods and shown in pricing UI.
 */
model PlanConfiguration {
  id                    String    @id @default(uuid()) @db.Uuid
  planType              OwnerPlan @unique @map("plan_type")
  activeListings        Int       @map("active_listings")
  offersPerPeriod       Int       @map("offers_per_period")
  aiUsesPerPeriod       Int       @map("ai_uses_per_period")
  boostCreditsPerPeriod Int       @map("boost_credits_per_period")
  boostDurationDays     Int       @map("boost_duration_days")
  updatedById           String?   @map("updated_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("plan_configuration")
}

model EntitlementGrant {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransactionId String?             @map("payment_transaction_id") @db.Uuid
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  type                 EntitlementType
  source               EntitlementSource   @default(ADDON)
  productSku           String              @map("product_sku")
  grantedQuantity      Int                 @map("granted_quantity")
  remainingQuantity    Int                 @map("remaining_quantity")
  startsAt             DateTime            @default(now()) @map("starts_at")
  expiresAt            DateTime            @map("expires_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([paymentTransactionId, type])
  @@index([userId, type, expiresAt])
  @@map("entitlement_grant")
}

model BoostCampaign {
  id                   String              @id @default(uuid()) @db.Uuid
  propertyId           String              @map("property_id") @db.Uuid
  property             Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId               String              @map("user_id") @db.Uuid
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransactionId String?             @unique @map("payment_transaction_id") @db.Uuid
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  productSku           String              @map("product_sku")
  durationDays         Int                 @map("duration_days")
  startsAt             DateTime            @map("starts_at")
  endsAt               DateTime            @map("ends_at")
  status               BoostCampaignStatus @default(SCHEDULED)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  viewEvents           PropertyViewEvent[]

  @@index([propertyId, startsAt, endsAt])
  @@index([userId, status])
  @@map("boost_campaign")
}

model PropertyViewEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  propertyId      String                 @map("property_id") @db.Uuid
  property        Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewerId        String?                @map("viewer_id") @db.Uuid
  viewer          User?                  @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  visitorHash     String                 @map("visitor_hash")
  dedupeKey       String                 @unique @map("dedupe_key")
  trafficSource   AnalyticsTrafficSource @default(ORGANIC) @map("traffic_source")
  boostCampaignId String?                @map("boost_campaign_id") @db.Uuid
  boostCampaign   BoostCampaign?         @relation(fields: [boostCampaignId], references: [id], onDelete: SetNull)
  occurredAt      DateTime               @default(now()) @map("occurred_at")

  @@index([propertyId, occurredAt])
  @@index([propertyId, visitorHash])
  @@map("property_view_event")
}

model PropertyAnalyticsDaily {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  views            Int      @default(0)
  uniqueViews      Int      @default(0) @map("unique_views")
  organicViews     Int      @default(0) @map("organic_views")
  boostedViews     Int      @default(0) @map("boosted_views")
  favoritesAdded   Int      @default(0) @map("favorites_added")
  favoritesRemoved Int      @default(0) @map("favorites_removed")
  tenantOffers     Int      @default(0) @map("tenant_offers")
  ownerOffers      Int      @default(0) @map("owner_offers")
  matches          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([propertyId, date])
  @@index([date])
  @@map("property_analytics_daily")
}

model LeaseContract {
  id                      String                     @id @default(uuid()) @db.Uuid
  matchConnectionId       String                     @map("match_connection_id") @db.Uuid
  matchConnection         MatchConnection            @relation(fields: [matchConnectionId], references: [id])
  generatedByUserId       String                     @map("generated_by_user_id") @db.Uuid
  generatedBy             User                       @relation(fields: [generatedByUserId], references: [id])
  ownerName               String                     @map("owner_name")
  ownerNationalId         String?                    @map("owner_national_id")
  tenantName              String                     @map("tenant_name")
  tenantNationalId        String?                    @map("tenant_national_id")
  propertyAddress         String                     @map("property_address")
  customClauses           String[]                   @map("custom_clauses")
  witness1Name            String?                    @map("witness1_name")
  witness1NationalId      String?                    @map("witness1_national_id")
  witness2Name            String?                    @map("witness2_name")
  witness2NationalId      String?                    @map("witness2_national_id")
  pdfUrl                  String?                    @map("pdf_url")
  startDate               DateTime                   @map("start_date")
  endDate                 DateTime                   @map("end_date")
  rentAmount              Float                      @map("rent_amount")
  status                  LeaseContractStatus        @default(DRAFTING)
  tenantReviewStatus      TenantContractReviewStatus @default(PENDING_REVIEW) @map("tenant_review_status")
  tenantChangeRequest     String?                    @map("tenant_change_request") @db.Text
  tenantChangeRequestedAt DateTime?                  @map("tenant_change_requested_at")
  tenantReviewConfirmedAt DateTime?                  @map("tenant_review_confirmed_at")
  draftRevision           Int                        @default(1) @map("draft_revision")
  tenantReviewedRevision  Int?                       @map("tenant_reviewed_revision")
  changeRequestNote       String?                    @map("change_request_note") @db.Text
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  userReviews             UserReview[]

  @@unique([matchConnectionId])
  @@map("lease_contract")
}

model UserReview {
  id                     String              @id @default(uuid()) @db.Uuid
  leaseContractId        String              @map("lease_contract_id") @db.Uuid
  leaseContract          LeaseContract       @relation(fields: [leaseContractId], references: [id], onDelete: Cascade)
  reviewerId             String              @map("reviewer_id") @db.Uuid
  reviewer               User                @relation("UserReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  revieweeId             String              @map("reviewee_id") @db.Uuid
  reviewee               User                @relation("UserReviewSubject", fields: [revieweeId], references: [id], onDelete: Restrict)
  direction              UserReviewDirection
  overallRating          Int                 @map("overall_rating")
  communicationRating    Int                 @map("communication_rating")
  responsivenessRating   Int                 @map("responsiveness_rating")
  propertyAccuracyRating Int?                @map("property_accuracy_rating")
  commitmentRating       Int?                @map("commitment_rating")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@unique([leaseContractId, reviewerId])
  @@index([revieweeId, createdAt])
  @@index([reviewerId])
  @@map("user_review")
}

model PartnerLead {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("tenant_id") @db.Uuid
  user        User               @relation(fields: [userId], references: [id])
  serviceType PartnerServiceType @map("service_type")
  // Legacy routing data is intentionally optional. New consent-based leads
  // are reviewed internally and are never assigned or sent to a partner.
  partnerName String?            @map("partner_name")
  consentedAt DateTime?          @map("consented_at")
  status      PartnerLeadStatus  @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("partner_lead")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("notification")
}

/**
 * Admin-panel login attempts (team activity page). Only ADMIN-role accounts are recorded.
 */
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  ip        String
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("login_attempt")
}

/**
 * Append-only record of sensitive admin moderation actions (team activity page).
 */
model AdminAuditLogEntry {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  subjectId String   @map("subject_id") @db.Uuid
  at        DateTime @default(now())

  @@index([at])
  @@map("admin_audit_log_entry")
}

enum ActivationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * A soft-deleted user's self-service request to have an admin restore their
 * account (POST /auth/request-reactivation). One row per attempt — a user
 * can be rejected and request again later.
 */
model ActivationRequest {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  user      User                    @relation(fields: [userId], references: [id])
  status    ActivationRequestStatus @default(PENDING)
  createdAt DateTime                @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("activation_request")
}

model Country {
  id           Int           @id @default(autoincrement())
  nameAr       String        @map("name_ar")
  nameEn       String        @map("name_en")
  code         String        @unique
  image        String
  status       Boolean       @default(true)
  governorates Governorate[]
  properties   Property[]

  @@map("country")
}

model Governorate {
  id         Int        @id @default(autoincrement())
  countryId  Int        @map("country_id")
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  nameAr     String     @map("name_ar")
  nameEn     String     @map("name_en")
  status     Boolean    @default(true)
  cities     City[]
  properties Property[]

  @@map("governorate")
}

model City {
  id            Int         @id @default(autoincrement())
  governorateId Int         @map("governorate_id")
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)
  nameAr        String      @map("name_ar")
  nameEn        String      @map("name_en")
  status        Boolean     @default(true)
  properties    Property[]
  districts     District[]

  @@map("city")
}

model District {
  id     Int     @id @default(autoincrement())
  cityId Int     @map("city_id")
  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  nameAr String  @map("name_ar")
  nameEn String  @map("name_en")
  status Boolean @default(false)

  @@map("district")
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING
  CLOSED
}

enum SupportAuthor {
  AI
  USER
  ADMIN
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

model SupportTicket {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  user               User             @relation("UserTickets", fields: [userId], references: [id])
  status             TicketStatus     @default(NEW)
  assignedAdminId    String?          @map("assigned_admin_id") @db.Uuid
  assignedAdmin      User?            @relation("AdminAssignedTickets", fields: [assignedAdminId], references: [id])
  messages           SupportMessage[]
  lastMessageAt      DateTime         @default(now()) @map("last_message_at")
  escalationReason   String?          @map("escalation_reason") @db.Text
  /// Legacy nullable field retained for migration compatibility; no agent may create tickets.
  agentEscalationKey String?          @unique @map("agent_escalation_key")
  priority           SupportPriority  @default(NORMAL)
  aiSummary          String?          @map("ai_summary") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([assignedAdminId, status])
  @@index([status, lastMessageAt])
  @@map("support_ticket")
}

model SupportMessage {
  id                   String                 @id @default(uuid()) @db.Uuid
  ticketId             String                 @map("ticket_id") @db.Uuid
  ticket               SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType           SupportAuthor
  authorName           String                 @map("author_name")
  authorId             String?                @map("author_id") @db.Uuid
  author               User?                  @relation(fields: [authorId], references: [id])
  content              String
  attachmentUrl        String?                @map("attachment_url")
  attachmentType       MessageAttachmentType? @map("attachment_type")
  attachmentName       String?                @map("attachment_name")
  attachmentDurationMs Int?                   @map("attachment_duration_ms")
  internal             Boolean                @default(false)
  createdAt            DateTime               @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_message")
}
